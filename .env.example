# ISU IPCR System - Environment Configuration
# Copy this file to .env and update with your actual values
# IMPORTANT: .env should NEVER be committed to version control!

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=ipcr_system
DB_CHARSET=utf8mb4

# Encryption Key (Generate random 32 character string)
# You can generate one with: openssl rand -base64 32
ENCRYPTION_KEY=change-this-to-random-32-char-key

# Application Settings
APP_ENV=development
APP_DEBUG=false

# Session Settings
SESSION_LIFETIME=21600
